{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true, // enable LSP for IDE integration
  "formatter": true, // enable code formatting
  "permission": { // enable websearch and webfetch for agents
    "websearch": "allow",
    "webfetch": "allow"
  },
  "agent": { // disable built-in agents and use our own instead
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-647a93ca-29f0-485c-8371-5a6473bfa3a1"
      }
    }
  },
  "provider": {
    "hermes": {
      "name": "Hermes",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://hermes.westpoint.edu:10241/v1"
      },
      "models": {
        "mistralai/Mistral-Medium-3.5-128B": {
          "name": "Mistral Medium 3.5",
          "family": "mistral",
          "reasoning": true,
          "tool_call": true,
          "release_date": "2026-04-29",
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "temperature": 0.7
          },
          "limit": {
            "context": 262144,
            "output": 262144
          }
        }
      }
    },
    "genaimil": {
      "name": "GenAI.mil",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.genai.mil/v1/",
        "apiKey": "STARK_vMl_uT5ExsMgDmgY6Wp-EvPiczQrmwwjgVRK-p0X1pA"
      },
      "models": {
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview",
          "family": "gemini-pro",
          "reasoning": true,
          "tool_call": false,
          "release_date": "2026-02-19",
          "options": {
            "reasoningSummary": "detailed",
            "forceReasoning": true
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash",
          "family": "gemini-flash",
          "reasoning": true,
          "tool_call": false,
          "release_date": "2026-08-13",
          "options": {
            "reasoningSummary": "auto"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "wire-glimmer": {
      "name": "ACI WIRE",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.icsarl.westpoint.edu/vllm-glimmer/v1"
      },
      "models": {
        "meta-models/Muse-Glimmer-30B": {
          "name": "Muse Glimmer 30B",
          "family": "muse",
          "reasoning": true,
          "tool_call": true,
          "release_date": "2026-08-10",
          "options": {
            "temperature": 1,
            "reasoningEffort": "xhigh",
            "reasoningSummary": "auto"
          },
          "limit": {
            "context": 131072,
            "output": 131072
          }
        }
      }
    },
  }
}
